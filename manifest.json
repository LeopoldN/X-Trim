{
  "manifest_version": 3,
  "name": "X Trim",
  "version": "0.3.5",
  "description": "Customize X\u2019s layout and themes, show optional account details, and save images, MP4 videos, and locally converted GIFs.",
  "permissions": [
    "storage",
    "webRequest",
    "downloads",
    "webRequestBlocking",
    "webRequestFilterResponse"
  ],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "X Trim"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "content.js",
        "about-profile.js",
        "theme.js",
        "media-download.js",
        "geo-timeline.js",
        "post-block.js",
        "theme-extras.js"
      ],
      "run_at": "document_start",
      "css": [
        "about-profile.css",
        "early-layout.css",
        "media-download.css",
        "geo-timeline.css",
        "post-block.css"
      ]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "x-clean-layout@local.example",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ],
        "optional": [
          "websiteContent",
          "browsingActivity",
          "authenticationInfo"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "background": {
    "scripts": [
      "data-consent.js",
      "about-background.js",
      "gif-background.js",
      "block-state.js",
      "media-background.js"
    ]
  },
  "optional_host_permissions": [
    "https://video.twimg.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; worker-src 'self'; object-src 'none'; connect-src 'self' https://x.com https://twitter.com https://video.twimg.com; media-src 'self' blob:; img-src 'self' data:; style-src 'self' 'unsafe-inline'; base-uri 'none'; frame-ancestors 'none'"
  }
}

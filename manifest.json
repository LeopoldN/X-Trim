{
  "manifest_version": 3,
  "name": "X Trim",
  "version": "0.5.1",
  "description": "Customize X\u2019s layout and themes, show optional account details, and save images, MP4 videos, and locally converted GIFs.",
  "permissions": [
    "storage",
    "webRequest",
    "downloads",
    "webRequestBlocking",
    "webRequestFilterResponse"
  ],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "X Trim"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "content/page-route.js",
        "content/layout.js",
        "content/account-details.js",
        "content/theme.js",
        "content/media-download.js",
        "content/geo-timeline.js",
        "content/post-block.js",
        "content/theme-extras.js",
        "content/usability.js",
        "content/explore.js"
      ],
      "run_at": "document_start",
      "css": [
        "content/account-details.css",
        "content/layout-early.css",
        "content/media-download.css",
        "content/geo-timeline.css",
        "content/post-block.css",
        "content/usability.css",
        "content/explore.css"
      ]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "x-clean-layout@local.example",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ],
        "optional": [
          "websiteContent",
          "browsingActivity",
          "authenticationInfo"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "background": {
    "scripts": [
      "shared/data-consent.js",
      "background/account-details.js",
      "background/gif-conversion.js",
      "background/post-block.js",
      "background/usability.js",
      "background/media-download.js"
    ]
  },
  "commands": {
    "toggle-focus-mode": {
      "suggested_key": {
        "default": "Alt+Shift+F"
      },
      "description": "Toggle X Trim focus mode on X"
    }
  },
  "optional_host_permissions": [
    "https://video.twimg.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; worker-src 'self'; object-src 'none'; connect-src 'self' https://x.com https://twitter.com https://video.twimg.com; media-src 'self' blob:; img-src 'self' data:; style-src 'self' 'unsafe-inline'; base-uri 'none'; frame-ancestors 'none'"
  }
}
